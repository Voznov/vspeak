{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "sourceMap": true,
    "incremental": true,
    "declaration": true,
    "removeComments": true,
    "alwaysStrict": true,
    "strictBindCallApply": false,
    "strictFunctionTypes": false,
    "strictPropertyInitialization": false,
    "noImplicitThis": false
  },
  "include": ["src/**/*", "../libs/**/*"],
  "exclude": ["dist", "node_modules"]
}
