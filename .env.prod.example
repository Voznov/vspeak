# JWT secret — generate with: openssl rand -base64 32
JWT_SECRET=

# Admin key — generate with: openssl rand -base64 32
ADMIN_KEY=

# Server
SERVER_DOMAIN_NAME=
HTTP_PORT=80
HTTPS_PORT=443

# WebRTC UDP port range
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40999

# PostgreSQL
POSTGRES_USER=vspeak
POSTGRES_PASSWORD=
POSTGRES_DB=vspeak

# MinIO credentials
MINIO_ROOT_USER=vspeak
MINIO_ROOT_PASSWORD=

# Nginx SSL
NGINX_SSL_CERTIFICATE_PATH=
NGINX_SSL_CERTIFICATE_KEY_PATH=
